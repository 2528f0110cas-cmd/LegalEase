{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app","--reload","--host","127.0.0.1","--port","8000"]
    },
    {
      "name": "Streamlit Frontend",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run","frontend/app.py"]
    }
  ]
}
